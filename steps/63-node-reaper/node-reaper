#!/usr/bin/env bash

# node-reaper — cap how many node processes one user may run, and how
# much RAM they may hold together, by killing the excess.
#
# Two limits, checked every NODE_REAPER_INTERVAL seconds:
#
#   NODE_REAPER_MAX_PROCS   more node processes than this → kill the
#                           NEWEST ones until back under. A swarm is
#                           always the newest arrivals; the long-lived
#                           ones (language servers, dev servers) survive.
#   NODE_REAPER_MAX_RSS_MB  their combined RSS above this → kill the
#                           LARGEST until back under.
#
# A victim gets SIGTERM; if it is still alive on the next pass, SIGKILL.
# Processes whose command line matches NODE_REAPER_EXEMPT (MCP servers by
# default) are neither counted nor killed.
#
# The scan loop uses only bash builtins over /proc — no ps/pgrep forks —
# so it keeps working when the box is already short on memory.
#
# Usage: node-reaper [--once] [--dry-run]

set -u

: "${NODE_REAPER_USER:=${SUDO_USER:-$USER}}"
: "${NODE_REAPER_MAX_PROCS:=48}"
: "${NODE_REAPER_MAX_RSS_MB:=65536}"
: "${NODE_REAPER_INTERVAL:=2}"
: "${NODE_REAPER_EXEMPT:=mcp|desktop-commander}"
: "${NODE_REAPER_DRY_RUN:=0}"

once=0
for arg in "$@"; do
    case "$arg" in
        --once) once=1 ;;
        --dry-run) NODE_REAPER_DRY_RUN=1 ;;
        *) echo "unknown argument: $arg" >&2; exit 2 ;;
    esac
done

target_uid=$(id -u "$NODE_REAPER_USER") || exit 1

declare -A terminated_at=()
declare -a pids=() rss_mb=() start_ticks=()

log() {
    echo "node-reaper: $*"
}

notify_user() {
    local runtime_dir="/run/user/$target_uid"
    [ -S "$runtime_dir/bus" ] || return 0
    command -v notify-send > /dev/null || return 0
    if [ "$(id -u)" -eq "$target_uid" ]; then
        notify-send --app-name=node-reaper --urgency=critical "node-reaper" "$1" &
    else
        setpriv --reuid="$target_uid" --regid="$(id -g "$NODE_REAPER_USER")" --init-groups \
            env DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" \
            notify-send --app-name=node-reaper --urgency=critical "node-reaper" "$1" &
    fi
}

is_node() {
    local comm
    # stderr is redirected before the read: redirects apply left to right,
    # and a pid exiting mid-scan would otherwise log a missing-file error.
    read -r comm 2> /dev/null < "/proc/$1/comm" || return 1
    # vitest renames its workers "node (vitest 3)". A bare node* glob would
    # also catch node_exporter and friends.
    [[ "$comm" == node || "$comm" == "node "* ]]
}

scan() {
    pids=() rss_mb=() start_ticks=()
    local dir pid uid rss key value stat fields cmdline
    for dir in /proc/[0-9]*; do
        pid=${dir#/proc/}
        is_node "$pid" || continue

        uid="" rss=0
        while read -r key value _; do
            case "$key" in
                Uid:) uid=$value ;;
                VmRSS:) rss=$value ;;
            esac
        done 2> /dev/null < "$dir/status"
        [ "$uid" = "$target_uid" ] || continue

        mapfile -d '' -t cmdline 2> /dev/null < "$dir/cmdline" || continue
        [[ "${cmdline[*]}" =~ $NODE_REAPER_EXEMPT ]] && continue

        read -r stat 2> /dev/null < "$dir/stat" || continue
        # comm may contain spaces and parens; everything after the last
        # ") " starts at field 3, which puts starttime (field 22) at 19.
        read -ra fields <<< "${stat##*) }"

        pids+=("$pid")
        rss_mb+=($((rss / 1024)))
        start_ticks+=("${fields[19]}")
    done
}

describe() {
    local pid=$1 cmdline
    mapfile -d '' -t cmdline 2> /dev/null < "/proc/$pid/cmdline"
    local text="${cmdline[*]}"
    echo "${text:0:160}"
}

reap() {
    local pid=$1 reason=$2
    if [ -n "${terminated_at[$pid]:-}" ]; then
        log "SIGKILL $pid (survived SIGTERM) — $reason"
        [ "$NODE_REAPER_DRY_RUN" = 1 ] || kill -KILL "$pid" 2> /dev/null
        return
    fi
    log "SIGTERM $pid — $reason — $(describe "$pid")"
    [ "$NODE_REAPER_DRY_RUN" = 1 ] && return
    kill -TERM "$pid" 2> /dev/null
    terminated_at[$pid]=$SECONDS
}

forget_dead() {
    local pid
    for pid in "${!terminated_at[@]}"; do
        [ -d "/proc/$pid" ] || unset "terminated_at[$pid]"
    done
}

# Indices into pids[], ordered by the given array, descending.
sorted_indices() {
    local -n values=$1
    local i
    for i in "${!values[@]}"; do
        echo "${values[$i]} $i"
    done | sort -rn | while read -r _ i; do echo "$i"; done
}

enforce() {
    local count=${#pids[@]} total_mb=0 i killed=0
    for i in "${!rss_mb[@]}"; do
        total_mb=$((total_mb + rss_mb[i]))
    done

    if [ "$count" -gt "$NODE_REAPER_MAX_PROCS" ]; then
        local excess=$((count - NODE_REAPER_MAX_PROCS))
        log "$count node processes > cap $NODE_REAPER_MAX_PROCS — reaping $excess newest"
        for i in $(sorted_indices start_ticks); do
            [ "$excess" -gt 0 ] || break
            reap "${pids[$i]}" "count cap ($count > $NODE_REAPER_MAX_PROCS)"
            total_mb=$((total_mb - rss_mb[i]))
            rss_mb[i]=0
            excess=$((excess - 1))
            killed=$((killed + 1))
        done
    fi

    if [ "$total_mb" -gt "$NODE_REAPER_MAX_RSS_MB" ]; then
        log "node RSS ${total_mb}M > cap ${NODE_REAPER_MAX_RSS_MB}M — reaping largest"
        for i in $(sorted_indices rss_mb); do
            [ "$total_mb" -gt "$NODE_REAPER_MAX_RSS_MB" ] || break
            [ "${rss_mb[$i]}" -gt 0 ] || continue
            reap "${pids[$i]}" "RSS cap (${total_mb}M > ${NODE_REAPER_MAX_RSS_MB}M, this one ${rss_mb[$i]}M)"
            total_mb=$((total_mb - rss_mb[i]))
            killed=$((killed + 1))
        done
    fi

    if [ "$killed" -gt 0 ] && [ "$NODE_REAPER_DRY_RUN" != 1 ]; then
        notify_user "Reaped $killed node process(es): $count running, ${total_mb}M left. See: journalctl -u node-reaper"
    fi
}

log "watching uid $target_uid: max $NODE_REAPER_MAX_PROCS procs, ${NODE_REAPER_MAX_RSS_MB}M RSS, exempt /$NODE_REAPER_EXEMPT/, dry-run=$NODE_REAPER_DRY_RUN"

while true; do
    forget_dead
    scan
    [ "$once" = 1 ] && log "${#pids[@]} node processes counted"
    enforce
    [ "$once" = 1 ] && break
    sleep "$NODE_REAPER_INTERVAL"
done
